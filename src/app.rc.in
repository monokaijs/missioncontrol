#include <windows.h>
1 RT_MANIFEST "@CMAKE_BINARY_DIR@/app.manifest"
1 VERSIONINFO
 FILEVERSION @MC_VERSION_COMMA@,0
 PRODUCTVERSION @MC_VERSION_COMMA@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "monokaijs"
   VALUE "FileDescription", "MissionControl - Telegram PC control"
   VALUE "FileVersion", "@MC_VERSION@"
   VALUE "ProductName", "MissionControl"
   VALUE "ProductVersion", "@MC_VERSION@"
   VALUE "OriginalFilename", "MissionControl.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
